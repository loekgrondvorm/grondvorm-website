<style>
:root{
  --ink:#0C2137;
  --navy:#12304F;
  --steel:#5C7692;
  --mist:#9FB4C7;
  --orange:#E2601C;
  --orange-lift:#F26E24;
  --paper:#FAF8F4;
  --tint:#EDF2F6;
  --line:#DDE4EB;
  --r-lg:30px;
  --r-md:20px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  background:var(--paper);color:var(--ink);
  font-family:"IBM Plex Sans",system-ui,sans-serif;
  font-size:17px;line-height:1.7;-webkit-font-smoothing:antialiased;
}
.wrap{max-width:1140px;margin:0 auto;padding:0 26px}
.mono{
  font-family:"IBM Plex Mono",monospace;font-size:12px;font-weight:500;
  letter-spacing:.18em;text-transform:uppercase;
}

/* header */
header{position:sticky;top:0;z-index:60;background:rgba(250,248,244,.9);backdrop-filter:blur(12px)}
.bar{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:16px 0}
.brand{display:flex;align-items:center;gap:11px;text-decoration:none;color:var(--navy)}
.brand b{font-family:Archivo,sans-serif;font-weight:700;font-size:19px;letter-spacing:-.02em}
nav{display:flex;align-items:center;gap:28px}
.links{display:flex;gap:26px}
.links a{color:var(--steel);text-decoration:none;font-size:15px;transition:color .18s ease}
.links a:hover{color:var(--orange)}
.cta{
  display:inline-flex;align-items:center;gap:10px;
  background:var(--orange);color:var(--navy);
  font-family:Archivo,sans-serif;font-weight:700;font-size:15.5px;letter-spacing:-.01em;
  padding:13px 26px;border-radius:999px;text-decoration:none;
  transition:background .2s ease,transform .2s ease,box-shadow .2s ease;
}
.cta:hover{background:var(--orange-lift);transform:translateY(-2px);box-shadow:0 10px 22px rgba(226,96,28,.28)}
.cta svg{transition:transform .2s ease}
.cta:hover svg{transform:translateX(3px)}
:focus-visible{outline:3px solid var(--orange);outline-offset:3px;border-radius:6px}

/* page head */
.page-head{padding:56px 0 8px}
.page-head .head{display:flex;align-items:center;gap:16px;margin-bottom:16px}
.page-head .head .mono{color:var(--steel);white-space:nowrap}
.page-head .head i{flex:1;height:1px;background:var(--line);display:block}
h1{font-family:Archivo,sans-serif;font-weight:700;font-size:clamp(32px,4.4vw,46px);line-height:1.08;letter-spacing:-.03em;color:var(--navy)}
.lead{margin-top:20px;font-size:19px;line-height:1.6;max-width:64ch;color:var(--navy)}
.meta{margin-top:20px;font-size:15px;color:var(--steel)}

/* document */
.doc{
  margin:36px 0 0;background:#fff;border-radius:var(--r-lg);
  padding:50px 56px;
  box-shadow:0 1px 2px rgba(12,33,55,.05),0 14px 34px rgba(12,33,55,.05);
}
.doc section{margin-top:38px}
.doc section:first-of-type{margin-top:0}
.doc h2{
  font-family:Archivo,sans-serif;font-weight:700;font-size:22px;
  letter-spacing:-.02em;color:var(--navy);line-height:1.2;margin-bottom:12px;
}
.doc h2 .n{
  display:inline-flex;align-items:center;justify-content:center;
  width:29px;height:29px;border-radius:50%;
  background:rgba(226,96,28,.14);color:var(--orange);
  font-size:12.5px;margin-right:12px;vertical-align:2px;
}
.doc p{max-width:70ch;margin-bottom:12px}
.doc p:last-child{margin-bottom:0}
.doc ul{list-style:none;margin:12px 0 14px}
.doc li{position:relative;padding-left:26px;margin-bottom:9px;max-width:70ch}
.doc li::before{content:"";position:absolute;left:0;top:.66em;width:9px;height:9px;border-radius:50%;background:var(--orange);opacity:.85}
.doc a{color:var(--orange);text-decoration:none;border-bottom:1px solid rgba(226,96,28,.35)}
.doc a:hover{border-bottom-color:var(--orange)}
.card{
  background:var(--tint);border-radius:var(--r-md);
  padding:22px 26px;margin:14px 0;max-width:70ch;font-size:16.5px;color:var(--navy);
}
.card p{margin-bottom:6px}
.card p:last-child{margin-bottom:0}

/* table */
.tbl{width:100%;border-collapse:collapse;margin:14px 0;font-size:16px}
.tbl th,.tbl td{text-align:left;vertical-align:top;padding:12px 16px;border-bottom:1px solid var(--line)}
.tbl th{
  font-family:Archivo,sans-serif;font-weight:700;font-size:13.5px;
  color:var(--navy);border-bottom:1px solid var(--navy);
}
.tbl tr:last-child td{border-bottom:none}
.scroll{overflow-x:auto;margin:14px 0}
.scroll .tbl{margin:0;min-width:520px}

footer{padding:56px 0 44px;color:var(--steel);font-size:14.5px}
footer .foot{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));
  gap:26px;align-items:start;
  border-top:1px solid var(--line);padding-top:30px;
}
footer .foot b{
  display:block;color:var(--navy);font-family:Archivo,sans-serif;
  font-weight:700;font-size:14px;margin-bottom:6px;
}
footer .foot span{display:block;line-height:1.6}
footer a{color:var(--steel);text-decoration:none}
footer a:hover{color:var(--orange)}

@media (max-width:900px){
  .links{display:none}
  .page-head{padding:36px 0 0}
  .doc{padding:32px 26px;border-radius:24px}
  .doc h2{font-size:20px}
  .doc h2 .n{display:flex;margin:0 0 10px}
}
</style>
